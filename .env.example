# ============================================================================
# CloudGuard configuration
# Copy to .env and adjust. Every value has a working default, so an empty .env
# still runs the full mocked stack.
# ============================================================================

# ---- application ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Regex alternative, for hosts that mint a new origin per deploy (Vercel
# previews). Leave empty unless you need it. Always end it with YOUR Vercel
# scope (the last segment of a preview URL); without it, other people's
# projects named cloudguard-dashboard-git-* would match too.
#   CORS_ORIGIN_REGEX=https://cloudguard-dashboard-git-[a-z0-9-]+-<your-vercel-scope>\.vercel\.app
CORS_ORIGIN_REGEX=

# ---- Redis (cache + Celery broker) ----------------------------------------
# docker compose overrides this to redis://redis:6379/0
# Managed Redis over TLS uses rediss://default:<password>@<host>:<port>;
# ssl_cert_reqs=required is appended automatically for Celery when absent.
REDIS_URL=redis://localhost:6379/0
# Leave blank to reuse REDIS_URL for Celery. (Celery itself also reads these two
# names from the environment; rediss:// values get the same TLS default.)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- client IPs behind a reverse proxy --------------------------------------
# Read by uvicorn, not by the app's settings: X-Forwarded-For is honoured only
# from these peers (IPs or CIDR ranges). Per-IP rate limiting needs your
# platform proxy's range here - see "Client IPs behind a proxy" in the README.
# Never use "*": clients could then choose their own IP.
#   FORWARDED_ALLOW_IPS=127.0.0.1

# ---- cache TTLs (seconds) ---
# Invariant: BEAT_* interval < FRESHNESS_* threshold < CACHE_TTL_*.
# Break it and a pipeline expires before beat refreshes it, so the
# dashboard empties out between cycles.----------------------------------------------
CACHE_TTL_CLOUD=600
CACHE_TTL_COST=3000
CACHE_TTL_FORECAST=3600
CACHE_TTL_SECURITY=900
CACHE_TTL_ANOMALY=900
TASK_RECORD_TTL=86400

# ---- periodic collection (Celery beat, seconds) ---------------------------
BEAT_CLOUD_INTERVAL=120
BEAT_SECURITY_INTERVAL=180
BEAT_COST_INTERVAL=600

# ---- cloud provider -------------------------------------------------------
# moto_inproc : in-process Moto mock (default, no extra services)
# moto_server : talk to a standalone moto_server over AWS_ENDPOINT_URL
# real        : real AWS, using real credentials and IAM permissions
CLOUD_MODE=moto_inproc
AWS_REGION=us-east-1
# Only used by moto_server / a custom endpoint. Leave blank otherwise.
AWS_ENDPOINT_URL=
# Dummy values are correct for the mocked modes; replace for CLOUD_MODE=real.
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing

# ---- deterministic demo data ----------------------------------------------
# Changing the seed changes the whole demo dataset, including the evaluation
# metrics. Keep it fixed for reproducible demonstrations.
DEMO_SEED=1337
DEMO_INSTANCE_COUNT=8
DEMO_HISTORY_DAYS=120
DEMO_SECURITY_EVENTS=240
LOG_GROUP_FLOW_LOGS=/cloudguard/vpc/flowlogs

# ---- cost forecasting (Prophet) -------------------------------------------
FORECAST_HORIZON_DAYS=30
FORECAST_BACKTEST_DAYS=14
# Low = stiffer trend, less chasing of one-off steps. Tuned on the backtest.
PROPHET_CHANGEPOINT_PRIOR_SCALE=0.01
PROPHET_SEASONALITY_MODE=multiplicative
PROPHET_INTERVAL_WIDTH=0.85
MONTHLY_BUDGET=14000
COST_SPIKE_THRESHOLD_PCT=15

# ---- anomaly detection (IsolationForest) ----------------------------------
# Expected proportion of outliers. Raising it flags more events.
ANOMALY_CONTAMINATION=0.025
ANOMALY_N_ESTIMATORS=240
ANOMALY_RANDOM_STATE=42
# Minimum 0-100 score before an event is reported as an anomaly.
ANOMALY_SCORE_THRESHOLD=65

# ---- API security ---------------------------------------------------------
# Leave empty to run open (local demo default). Set a value to require
# "X-API-Key: <key>" on the endpoints that queue ML work. Never commit a real key.
CLOUDGUARD_API_KEY=
# Fixed-window limit on those same write endpoints. 0 disables limiting.
RATE_LIMIT_WRITE_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# "Inject test anomaly" adds an event to data every visitor shares, and it stays
# until the API restarts. Left unset, it is allowed everywhere except
# ENVIRONMENT=production. Set true or false to decide explicitly.
#   ALLOW_ANOMALY_INJECTION=false

# ---- data freshness -------------------------------------------------------
# How old cached data may be before the dashboard flags it as stale. Must stay
# BELOW the matching CACHE_TTL_* above, or the stale state is unreachable.
FRESHNESS_CLOUD=300
FRESHNESS_COST=1500
FRESHNESS_FORECAST=1500
FRESHNESS_SECURITY=420
FRESHNESS_ANOMALY=420
LAST_SUCCESS_TTL=604800

# ---- frontend (build-time, read by Vite) ----------------------------------
# Only set this when the dashboard is hosted on a DIFFERENT origin from the API
# - which includes Vercel, where it is required (set it in the Vercel project,
# then redeploy). Leave empty for the compose setup: nginx and the Vite dev
# server both proxy /api to the backend, so the browser stays same-origin.
# Setting it to http://localhost:8000 would bake that literal URL into the
# bundle, which breaks for anyone opening the dashboard from another machine.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=20000
VITE_DASHBOARD_POLL_MS=20000
# Must match CLOUDGUARD_API_KEY when authentication is enabled - but NEVER set
# it for a public build (Vercel included): Vite inlines VITE_* values into the
# JavaScript bundle, so the key would be readable by every visitor.
VITE_API_KEY=
